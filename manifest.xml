<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
        Watch face: shows only the current UV index for the current location.
        Data source: Toybox.Weather (fed by Garmin Connect via your phone).
    -->
    <iq:application id="afa93e1472dd40ad9be3541373f93d1c" type="watchface" name="@Strings.AppName" entry="UvFaceApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="venu445mm"/>
            <iq:product id="venu441mm"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="vivoactive6"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenixe"/>
        </iq:products>
        <!-- Toybox.Weather itself needs no permission, but
             CurrentConditions.observationLocationName returns null
             without Positioning (used for the provenance line). -->
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>