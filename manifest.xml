<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
        Watch face: shows only the current UV index for the current location.
        Data source: Toybox.Weather (fed by Garmin Connect via your phone).
    -->
    <iq:application id="c2ada1e1b74f4f60a16b2463e0ea0784" type="watchface" name="@Strings.AppName" entry="UvFaceApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="venu445mm"/>
        </iq:products>
        <!-- Toybox.Weather needs no special permission -->
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>